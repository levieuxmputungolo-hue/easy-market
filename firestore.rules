rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stats globaux
    match /stats/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Utilisateurs
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vendeurs
    match /vendeurs/{vendorId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == vendorId;
    }

    // Produits
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.vendeur_id == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.vendeur_id == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.vendeur_id == request.auth.uid || resource.data.seller_id == request.auth.uid);
    }

    // Commandes (WhatsApp notifications)
    match /orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.user_id == request.auth.uid || resource.data.seller_id == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (resource.data.user_id == request.auth.uid || resource.data.seller_id == request.auth.uid);
    }

    // Notifications in-app
    match /notifications/{userId}/items/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Compteurs de notifications
    match /notification_counts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Abonnements vendeurs (followers)
    match /followers/{followerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Tokens FCM
    match /fcm_tokens/{token} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Demandes clients
    match /demands/{demandId} {
      allow read, write: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // Vrai si l'utilisateur connecté fait partie de la conversation parente
    function estParticipant(chatId) {
      return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
          || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.get('buyer_id', '')
          || request.auth.uid == get(/databases/$(database)/documents/chats/$(chatId)).data.get('seller_id', '');
    }

    // Chats (privé : acheteur <-> vendeur uniquement)
    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.participants
            || request.auth.uid == resource.data.get('buyer_id', '')
            || request.auth.uid == resource.data.get('seller_id', ''));
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null && estParticipant(chatId);
        allow create: if request.auth != null && estParticipant(chatId)
          && request.resource.data.get('senderId', '') == request.auth.uid;
        allow update: if request.auth != null && estParticipant(chatId);
        allow delete: if false;
      }
    }

    // Publicités
    match /publicites/{pubId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == resource.data.vendor_id;
      allow update: if request.auth != null && resource.data.vendor_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.vendor_id == request.auth.uid;
    }
  }
}

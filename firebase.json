{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/manifest.json",
        "headers": [{ "key": "Cache-Control", "value": "max-age=3600" }]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|svg|webp|woff|woff2|mp4|webm)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=3600" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store" }]
      }
    ],
    "rewrites": [
      {"source": "/manifest.json", "destination": "/manifest.json"},
      {"source": "/sw.js", "destination": "/sw.js"},
      {"source": "/assets/**", "destination": "/assets/**"},
      {"source": "/publicitaire*", "destination": "/publicitaire/index.html"},
      {"source": "**", "destination": "/index.html"}
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs18",
    "predeploy": ["npm --prefix functions install"]
  }
}
